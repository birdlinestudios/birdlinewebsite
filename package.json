{
  "name": "birdline-site",
  "version": "1.0.0",
  "private": true,
  "description": "birdlinestudios.com on Next.js: the page content is generated into content/ by tools/generator, the app renders it.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "content": "BIRDLINE_NEXT=. python3 tools/generator/site/build_site.py tools/generator/assets .generator-out",
    "videos:upload": "bash scripts/upload-videos.sh",
    "vercel:setup": "bash scripts/setup-vercel.sh"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vercel": "^65.11.0"
  }
}
