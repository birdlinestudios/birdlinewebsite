# Copy to .env.local for local development. On Vercel, set these under Project → Settings → Environment Variables.

# Where the videos are served from. Leave empty to use the files in public/video (local development).
# In production, the public URL of the folder holding the same files, for example a Vercel Blob store:
# NEXT_PUBLIC_VIDEO_BASE=https://xxxxxxxxxxxxxxxx.public.blob.vercel-storage.com
NEXT_PUBLIC_VIDEO_BASE=

# The site's public address, used for absolute URLs in social-sharing metadata.
NEXT_PUBLIC_SITE_URL=https://birdlinestudios.com
