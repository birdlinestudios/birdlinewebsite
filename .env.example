# Copy to .env.local for local development. On Vercel, set these under Project → Settings → Environment Variables.

# Where the videos are served from. Leave empty to use the files in public/video (local development).
# In production, the public URL of the folder holding the same files, for example a Vercel Blob store:
# NEXT_PUBLIC_VIDEO_BASE=https://xxxxxxxxxxxxxxxx.public.blob.vercel-storage.com
NEXT_PUBLIC_VIDEO_BASE=

# The site's public address, used for absolute URLs in social-sharing metadata.
NEXT_PUBLIC_SITE_URL=https://birdlinestudios.com

# Booking form notifications (app/api/book/route.ts). Each "Book a call" submission is emailed through Resend (resend.com).
# Get the key from resend.com → API Keys, or install the Resend integration from the Vercel Marketplace, which sets it for you.
# Without it submissions are still written to the Vercel function log, and the visitor still reaches the calendar.
RESEND_API_KEY=
# Who gets the email (several addresses separated by commas). Default: mike@birdlinestudios.com
BOOK_NOTIFY_TO=mike@birdlinestudios.com
# The sender. Resend accepts "onboarding@resend.dev" before a domain is verified (then it delivers only to the Resend
# account's own address); after verifying birdlinestudios.com in Resend, use an address on it.
BOOK_NOTIFY_FROM=Birdline Website <onboarding@resend.dev>
